/****************************************************************************************
System:     OpenHAB version 2.5
File:       home.items
Purpose:    To define generic items used by the system
Author :    Jaime Rubio 2023 (c)
Notes:      I put the labels in French because they are often used by the UI HabPanel
*****************************************************************************************/

// Rooms
Group           Home                        "Malassis"            <house>                                              ["Building"]
Group           B                           "Sous-sol"            <pantry>             (Home)                          ["Basement"]
Group           GF                          "Rez-de-chaussée"     <groundfloor>        (Home)                          ["GroundFloor"]
Group           FF                          "Premier étage"       <firstfloor>         (Home)                          ["FirstFloor"]
Group           OU                          "Dehors"              <garden>             (Home)                          ["Outdoor"]
Group           AT                          "Grenier"             <attic>              (Home)                          ["Attic"]
Group           B_Garage                    "Garage"              <garage>             (B)      
Group           B_LaundryRoom               "Buanderie"           <washingmachine>     (B)      {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           B_Studio                    "Studio"              <studio>             (B)     
Group           B_Cellar                    "Cave"                <cellar>             (B)     
Group           GF_Entryway                 "Entrée"              <frontdoor>          (GF)     
Group           GF_Toilet                   "Toilettes"           <toilet>             (GF)     
Group           GF_DiningRoom               "Salle à manger"      <party>              (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Lounge                   "Salon"               <sofa>               (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Kitchen                  "Cuisine"             <kitchen>            (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_MasterBedroom            "Chambre parentale"   <bedroom_red>        (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Bathroom                 "Salle de bain"       <bath>               (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Corridor                 "Couloir"             <corridor>           (FF)     
Group           FF_Bedroom1                 "Chambre Clara"       <bedroom_blue>       (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bedroom2                 "Chambre Inés"        <bedroom_red>        (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bedroom3                 "Chambre Julia"       <bedroom_green>      (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Office                   "Bureau"              <office>             (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bathroom                 "Salle de bain"       <bath>               (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_WC                       "WC"                  <bath>               (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           OU_Terrace                  "Terrasse"            <terrace>            (OU)     
Group           OU_Backyard                 "Jardin"              <lawnmower>          (OU)     
Group           AT_StorageRoom              "Grenier"             <suitcase>           (AT)     

// Settings
Group           gSettings                   "Paramètres"           <settings>           (Home)
Switch          Debug_Mode                  "Debug Mode"           <switch>             (Home) 

// Voice Control
String          VoiceCommand       
Switch          VoiceListening     

// Functional Groups
Group:Dimmer:AVG                   gBattery         "Etat des piles"       <battery>            (Home)
Group:Switch:OR(ON, OFF)           gBatteryLow      "Piles déchargées"     <battery>            (Home)
Group:Number:AVG                   gSignal          "Signal"               <qualityofservice>   (Home)
Group:Switch:OR(ON, OFF)           gLighting        "Lumière"              <light>              (Home)
Group:Switch:OR(ON, OFF)           gGardenLight     "Lumière"              <light>              (Home)
Group:Contact:OR(OPEN, CLOSED)     gMotion          "Mouvement"            <motion>             (Home)
Group:Contact:OR(OPEN, CLOSED)     gMotionLight     "Lumière avec capteur" <light>              (Home)
Group:Switch:OR(ON, OFF)           gMotionSwitch    "Active les capteurs"  <switch>             (Home)
Group:Switch:OR(ON, OFF)           gSensor          "Détecteur"            <sensor>             (Home)      
Group:Contact:OR(OPEN, CLOSED)     gDoor            "Portes"               <door>               (Home)
Group:Contact:OR(OPEN, CLOSED)     gWindow          "Fenêtres"             <door>               (Home)
Group:Rollershutter:AVG            gShutter         "Volets"               <rollershutter>      (Home)
Group:Switch:OR(ON, OFF)           gRFLink          "Switches commandés par RFLink"   <light>   (Home)   

