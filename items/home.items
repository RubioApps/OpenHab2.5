/****************************************************************************************
System:     OpenHAB version 2.5
File:       home.items
Purpose:    To define generic items used by the system
Author :    Jaime Rubio 2023 (c)
Notes:      I put the labels in French because they are often used by the UI HabPanel
*****************************************************************************************/

// Rooms
Group           Home                        "My House"            <house>                                              ["Building"]
Group           B                           "Basement"            <pantry>             (Home)                          ["Basement"]
Group           GF                          "Ground floor"        <groundfloor>        (Home)                          ["GroundFloor"]
Group           FF                          "First floor"         <firstfloor>         (Home)                          ["FirstFloor"]
Group           OU                          "Outdoors"            <garden>             (Home)                          ["Outdoor"]
Group           AT                          "Attic"               <attic>              (Home)                          ["Attic"]
Group           B_Garage                    "Garage"              <garage>             (B)      
Group           B_LaundryRoom               "Laundryroom"         <washingmachine>     (B)      {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           B_Studio                    "Studio"              <studio>             (B)     
Group           B_Cellar                    "Cellar"              <cellar>             (B)     
Group           GF_Entryway                 "Front door"          <frontdoor>          (GF)     
Group           GF_Toilet                   "Toilets"             <toilet>             (GF)     
Group           GF_DiningRoom               "Dining room"         <party>              (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Lounge                   "Lounge"              <sofa>               (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Kitchen                  "Kitchen"             <kitchen>            (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_MasterBedroom            "Master bedroom"      <bedroom_red>        (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           GF_Bathroom                 "Master bathroom"     <bath>               (GF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Corridor                 "Corridor"            <corridor>           (FF)     
Group           FF_Bedroom1                 "Bedroom 1"           <bedroom_blue>       (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bedroom2                 "Bedroom 2"           <bedroom_red>        (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bedroom3                 "Bedroom 3"           <bedroom_green>      (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Office                   "Office"              <office>             (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_Bathroom                 "Bathroom"            <bath>               (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           FF_WC                       "WC"                  <bath>               (FF)     {ga="Thermostat"[ modes="heat,eco,heatcool,off" , thermostatTemperatureRange="4,25"] }
Group           OU_Terrace                  "Terrace"             <terrace>            (OU)     
Group           OU_Backyard                 "Garden"              <lawnmower>          (OU)     
Group           AT_StorageRoom              "Attic"               <suitcase>           (AT)     

// Settings
Group           gSettings                   "Settings"           <settings>           (Home)
Switch          Debug_Mode                  "Debug Mode"           <switch>             (Home) 

// Voice Control
String          VoiceCommand       
Switch          VoiceListening     

// Functional Groups
Group:Dimmer:AVG                   gBattery         "Batteries"       <battery>            (Home)
Group:Switch:OR(ON, OFF)           gBatteryLow      "Battery depletted"    <battery>            (Home)
Group:Number:AVG                   gSignal          "Signal"               <qualityofservice>   (Home)
Group:Switch:OR(ON, OFF)           gLighting        "Lighting"              <light>             (Home)
Group:Switch:OR(ON, OFF)           gGardenLight     "Garden lights"         <light>             (Home)
Group:Contact:OR(OPEN, CLOSED)     gMotion          "Motion"                <motion>            (Home)
Group:Contact:OR(OPEN, CLOSED)     gMotionLight     "Motion lights"         <light>             (Home)
Group:Switch:OR(ON, OFF)           gMotionSwitch    "Motion sensors"        <switch>            (Home)
Group:Switch:OR(ON, OFF)           gSensor          "Sensors"               <sensor>            (Home)      
Group:Contact:OR(OPEN, CLOSED)     gDoor            "Doors"                 <door>              (Home)
Group:Contact:OR(OPEN, CLOSED)     gWindow          "Windows"               <door>              (Home)
Group:Rollershutter:AVG            gShutter         "Shutters"              <rollershutter>     (Home)
Group:Switch:OR(ON, OFF)           gRFLink          "RF Switches"           <light>             (Home)   

// Boiler
Switch                  B_Boiler_Switch                 "Boiler"                   <boiler>             (B_LaundryRoom)                          {channel="mqtt:topic:mosquitto:boiler:switch"}

// Appliances
Group                   gAppliances                 "Appliances"                  <appliance>          (Home)
Switch                  B_AirPurifier_Switch        "Putifier switch"             <fan_box>            (B_LaundryRoom, gAppliances)             {ga="AirPurifier"}
Switch                  B_AirPurifier_Mode          "Sleep mode"                  <fan_box>            (B_LaundryRoom, gAppliances)                 
Switch                  B_AirPurifier_Speed         "High speed"                  <fan_box>            (B_LaundryRoom, gAppliances)            
Switch                  GF_Dishwasher               "Dish washer"                 <appliance>          (FF_Kitchen, gAppliances)        

// Switches
Switch                  AutoDryer                   "Auto Dryer"                  <fan>                (Home, gSettings)
Switch                  AutoLight                   "Auto garden light"           <light>              (Home, gSettings)
Switch                  AutoMotionLight             "Auto motion light"           <light>              (Home, gSettings)
Switch                  AutoAwning                  "Awning"                      <rollershutter>      (Home, gSettings)
Switch                  AutoShutters                "Shutters"                    <rollershutter>      (Home, gSettings)
Switch                  AutoScene                   "Presence emulator"           <timer>              (Home, gSettings)
Switch                  PhoneDetection              "Phone detector"              <phone>              (Home, gSettings)   

Dimmer                  B_LaundryRoom_HumidityMax   "Humidity threshold"          <dimmer>             (B_LaundryRoom) 
Switch                  B_LaundryRoom_Power         "Dryer switch"                <poweroutlet>        (B_LaundryRoom)                          {channel="mqtt:topic:mosquitto:powerlet:ssw_laundryroom"}    
Switch                  GF_Entryway_Power           "Entryway power plug"         <poweroutlet>        (GF_Entryway, gLighting)                 {channel="mqtt:topic:mosquitto:powerlet:ssw_entryway", ga="Light"}                    
Switch                  FF_Corridor_Power           "Corridor power plug"         <poweroutlet>        (FF_Corridor, gLighting)                 {channel="mqtt:topic:mosquitto:powerlet:ssw_corridor", ga="Light"}                    
Switch                  GF_Lounge_Power             "Lounge power plug"           <poweroutlet>        (GF_Lounge, gLighting)                   {channel="mqtt:topic:mosquitto:powerlet:ssw_lounge", ga="Light"}     
Switch                  OU_Porche_Light             "Front door light"            <light>              (OU_Backyard, gLighting)                 {channel="mqtt:topic:mosquitto:lighting:ssw_porch", ga="Light"}        
Switch                  OU_Terrace_Light            "Terrace light"               <light>              (OU_Backyard, gLighting)                 {channel="mqtt:topic:mosquitto:lighting:ssw_terrace", ga="Light"}        
Switch                  OU_Garage_Light 	   	    "Shed light"                  <light>              (OU_Backyard, gGardenLight, gRFLink)     ["NewKaku-XXXXXXXX-X"] {channel="mqtt:topic:mosquitto:rflink:light3", ga="Light"}
Switch                  OU_FrontGate_Light 	   	    "Doorway light"               <light>              (OU_Backyard, gGardenLight, gRFLink)     ["NewKaku-XXXXXXXX-X"] {channel="mqtt:topic:mosquitto:rflink:light4", ga="Light"}
Switch                  OU_Pond_Pump                "Pond"                        <switch>             (OU_Backyard)                            {channel="mqtt:topic:mosquitto:pond:ssw_pond"}        
Switch                  OU_Frontyard                "Fountain"                    <switch>             (OU_Backyard)                            {channel="mqtt:topic:mosquitto:frontyard:ssw_frontyard"}        

// Buttons
String                  GF_AllShutters_Button       "All shutters button switch"  <poweroutlet>        (Home)                                   {channel="mqtt:topic:mosquitto:btn_shutters:action"}    
Dimmer                  GF_AllShutters_Battery      "All shutters button battery" <battery>            (Home)                                   {channel="mqtt:topic:mosquitto:btn_shutters:battery"}    
Number:Dimensionless    GF_AllShutters_Signal       "All shuttters button signal" <qualityofservice>   (Home)                                   {channel="mqtt:topic:mosquitto:btn_shutters:quality"}    

// Shutters 
// in MQTT binding: [profile="transform:JS", function="invert-blind.js", sourceFormat="%d"]
Rollershutter           OU_Terrace_Awning           "Awning"                 <rollershuter>       (OU_Terrace, gRFLink)                    ["RTS-XXXXXX-X"]  {ga="Awning"}
Rollershutter           OU_Garden_Gate              "Doorway"                <door>               (OU_Backyard, gDoor)                     ["RTS-XXXXXX-X"]  {ga="Gate"}
Rollershutter           OU_Awning_Key1              "Keyfob 1"               <door>               (OU_Terrace)                             {channel="mqtt:topic:mosquitto:rflink:awning-key1", ga="Awning"}
Rollershutter           OU_Awning_Key2              "Keyfob 2"               <door>               (OU_Terrace)                             {channel="mqtt:topic:mosquitto:rflink:awning-key2", ga="Awning"}
Rollershutter           GF_Curtains                 "Ground floor shutters"  <rollershutter>      (GF)     
Rollershutter           GF_DiningRoom_Curtain       "Dining room shutter"    <rollershutter>      (GF_DiningRoom, gShutter)                ["crt_dining"] {channel="mqtt:topic:mosquitto:crt_dining:cover", ga="Shutter"}
Rollershutter           GF_Lounge_Curtain           "Lounge shutter"         <rollershutter>      (GF_Lounge, gShutter)                    ["crt_lounge"] {channel="mqtt:topic:mosquitto:crt_lounge:cover", ga="Shutter"}
Rollershutter           GF_MasterBedroom_Curtain    "Master bedroom shutter" <rollershutter>      (GF_MasterBedroom, gShutter)             ["crt_masterbedroom"] {channel="mqtt:topic:mosquitto:crt_masterbedroom:cover", ga="Shutter"}
Rollershutter           GF_KitchenOffice            "Office shutter"         <rollershutter>      (GF_Kitchen, gShutter)                   ["crt_kitchenoffice"] {channel="mqtt:topic:mosquitto:crt_kitchenoffice:cover", ga="Shutter"}
Rollershutter           GF_KitchenDoor              "Kitchen shutter"        <rollershutter>      (GF_Kitchen, gShutter)                   ["crt_kitchendoor"] {channel="mqtt:topic:mosquitto:crt_kitchendoor:cover", ga="Shutter"}
Rollershutter           GF_KitchenSink              "Sink shutter"           <rollershutter>      (GF_Kitchen, gShutter)                   ["crt_kitchensink"] {channel="mqtt:topic:mosquitto:crt_kitchensink:cover", ga="Shutter"}

//Awning
Number:Temperature		Terrace_Temperature		    "Temperature [%.1f %unit%]"  <temperature>    (OU_Terrace)	                        {channel="mqtt:topic:mosquitto:rflink:barigo"}
Number:Speed  		    Terrace_Wind_Max  	        "Wind speed [%.2f]"                           (OU_Terrace)
Number:Dimensionless    Terrace_UV_Min              "Min. UV Index [%.1f]"                        (OU_Terrace)
Number:Temperature		Terrace_Temp_Min 			"Min. temperature [%.1f %unit%]"    <temperature>     (OU_Terrace)
DateTime            	Terrace_StartTime       	"Start time"                        <timer>           (OU_Terrace)
DateTime            	Terrace_EndTime         	"End time"                          <timer>           (OU_Terrace)
Rollershutter           Terrace_AwningOpen          "Aperture store banne"              <rollershuter>    (OU_Terrace)

//**********************************************************************************    
// Infrastructure
//**********************************************************************************
// RFLink
Group	    gRFBox      	    "RF Gateway"	    (Home)	
String      RFLink_State        "RFLink State"      (gRFBox)     {channel="mqtt:topic:mosquitto:rflink:reception"}
String      RFLink_Command      "RFLink Command"    (gRFBox)

// There is 2 alternatives to get connection status of a device
// 1. HTTP Binding:     
// 2. Network Binding:  {channel="network:pingdevice:tv:online"}

// When using the HTTP Binding, the Java heap and high CPU consumption occurs. Not recommended. Configured at .items file
// {http="<[https://yourdomainhere.com/getip.txt:3000000:JS(connected.js)]"}

// When using the Network Binding, there is an issue when Resolving (port 5353) and arp/ping fail, but it can be solved
// See /services/network.cfg
// 1. Service: {channel="network:servicedevice:mosquitto"}
// 2. Ping:    {channel="network:pingdevice:modem"}

Group   gNetwork        "Network"       (Home)
Switch  NetworkOnline_Modem             "Modem"        (gNetwork)              {channel="network:pingdevice:modem:online"}
Switch  NetworkOnline_Router            "Router"       (gNetwork)              {channel="network:servicedevice:mosquitto:online"}
Switch  NetworkOnline_Zigbee2mqtt       "Zigbee"       (gNetwork)              {channel="mqtt:topic:zigbee2mqtt:state"}
Switch  NetworkOnline_RFLink2mqtt       "RFLink"       (gNetwork)              


// Server
Group   gLocalComputer  "OpenHab Server"  (Home)
String                  LocalComputer_Name           "Server"                      (gLocalComputer)                {channel="systeminfo:computer:srv-nas:cpu#name"}
Number:Dimensionless    LocalComputer_Storage_Total  "HDD [%d]"                     (gLocalComputer)                {channel="systeminfo:computer:srv-nas:storage#total"}
Number:Dimensionless    LocalComputer_Storage_Used   "HDD [%d %%]"                  (gLocalComputer)                {channel="systeminfo:computer:srv-nas:storage#usedPercent"}
Number:Dimensionless    LocalComputer_Swap_Total     "Swap [%d]"                    (gLocalComputer)                {channel="systeminfo:computer:srv-nas:swap#total"}
Number:Dimensionless    LocalComputer_Swap_Used      "Swap [%d %%]"                 (gLocalComputer)                {channel="systeminfo:computer:srv-nas:swap#usedPercent"}
Number:Dimensionless    LocalComputer_Memory_Total   "RAM [%d]"                     (gLocalComputer)                {channel="systeminfo:computer:srv-nas:memory#total"}
Number:Dimensionless    LocalComputer_Memory_Used    "RAM [%d %%]"                  (gLocalComputer)                {channel="systeminfo:computer:srv-nas:memory#usedPercent"}
DateTime                LocalComputer_DateTime       "Local time [%1$tH:%1$tM]"   (gLocalComputer)                {channel="ntp:ntp:local:dateTime"}

// Internet Speed
Group           gSpeedtest      "SpeedTest"     (Home)
String          Speedtest_Summary       "Speed test [%s]"               <network>                       (gSpeedtest)
Number          Speedtest_ResultPing    "Ping [%.3f ms]"                <time>                          (gSpeedtest)
Number          Speedtest_ResultDown    "Upstream [%.2f Mbit/s]"        <flowpipe>                      (gSpeedtest)
Number          Speedtest_ResultUp      "Downstream [%.2f Mbit/s]"      <returnpipe>                    (gSpeedtest)
String          Speedtest_Running       "Ongoing ... [%s]"              <line>                          (gSpeedtest)
Switch          Speedtest_Rerun         "Start"                         <switch>                        (gSpeedtest)
DateTime        Speedtest_ResultDate    "Last test [%1$td.%1$tm.%1$tY, %1$tH:%1$tM H]"   <calendar>     (gSpeedtest)
