/****************************************************************************************
System:     OpenHAB version 2.5
File:       heating.items
Purpose:    To define items used by the Heating System
Author :    Jaime Rubio 2023 (c)
*****************************************************************************************/

//**********************************************************************************
// Groups
//**********************************************************************************

// Heating control
Switch          Heating_Switch              "Heating switch"         <switch>       (Home)       
Switch          Heating_Timer               "Heating timer"          <timer>        (Home)    //ON=Heating period;OFF=Idle period
Number          Heating_LastChange          "Last state change"      <timer>        (Home)    //Last time the boiler changed
Switch          Heating_Init                "Reset radiators"        <switch>       (Home)    //Flag to initialize the radiators
Switch          Heating_Calibrate           "Calibrate radiators"    <switch>       (Home)    //Flag to calibrate the radiators
Switch          Heating_ChildLock           "Child lock"             <switch>       (Home)    //Flag to set the child lock
Switch          Heating_AutoLock            "Auto lock"              <switch>       (Home)    //Flag to set the auto lock
Switch          Heating_Toogle              "Heating toggle"         <switch>       (Home)    //Flag to trigger an update after new settings

// Heater settings
Number          Heating_BoostTime           "Boost time [%d]"           <timer>        (Home)
Number          Heating_DaysAway            "Holidays [%d]"             <timer>        (Home)
DateTime        Heating_FirstDayAway        "First day away"            <timer>        (Home)
Switch          ValveDetection              "Detect valves"             <heating>      (Home)

// Regulation modes
Group:Switch:OR(ON, OFF)           gRegModes                    (Home)
Switch          Heating_Schedule            "Schedule mode"      <heating>            (gRegModes)    
Switch          Heating_Comfort             "Confort mode"       <heating>            (gRegModes)    
Switch          Heating_Eco                 "Eco mode"           <heating>            (gRegModes)    
Switch          Heating_Boost               "Boost mode"         <heating>            (gRegModes)    
Switch          Heating_Manual              "Manual mode"        <heating>            (gRegModes)    
Switch          Heating_Away                "Holidays mode"      <heating>            (gRegModes)    
Switch          Heating_Off                 "Off mode"           <heating>            (gRegModes)    
String          Heating_Mode                "Current mode"       <heating>            


// Temperature setpoint by mode
Group:Number:AVG            gSetpointModes
Number:Temperature          Setpoint_Comfort    "Setpoint Confort [%.1f %unit%]"       <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Eco        "Setpoint Eco [%.1f %unit%]"           <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Away       "Setpoint Holidays [%.1f %unit%]"      <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Loss       "Maximum loss [%.1f %unit%]"      <temperature>         (Home) 

// Heaters/Radiators/TRV
Group:Switch:OR(ON, OFF)    gHeater         "Radiator"                       <heating>      (Home)
Group:Switch:OR(ON, OFF)    gHeaterIgnored  "Radiator ignored"                <heating>      (Home)

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gTemperature    "Temperature"               <temperature>   (Home)
Group:Number:AVG            gTemp_Z1        "Temperature bathrooms"     <temperature>   (gTemperature)       
Group:Number:AVG            gTemp_Z2        "Temperature ground floor"  <temperature>   (gTemperature)   
Group:Number:AVG            gTemp_Z3        "Temperature first floor"   <temperature>   (gTemperature)       
Group:Number:AVG            gTemp_Z4        "Temperature basement"      <temperature>   (gTemperature)  
Group:Number:AVG            gTemp_Z5        "Temperature attic"         <temperature>   (gTemperature)  

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gHumidity       "Humidity"                  <humidity>      (Home)
Group:Number:AVG            gHumidity_Z1    "Humidity bathrooms"        <humidity>      (gHumidity)       
Group:Number:AVG            gHumidity_Z2    "Humidity ground floor"     <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z3    "Humidity first floor"      <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z4    "Humidity basement"         <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z5    "Humidity attic"            <humidity>      (gHumidity)    

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gPressure       "Preasure"                  <pressure>      (Home)
Group:Number:AVG            gPressure_Z1    "Preasure bathrooms"        <pressure>      (gPressure)       
Group:Number:AVG            gPressure_Z2    "Preasure ground floor"     <pressure>      (gPressure)   
Group:Number:AVG            gPressure_Z3    "Preasure first floor"      <pressure>      (gPressure) 
Group:Number:AVG            gPressure_Z4    "Preasure basement"         <pressure>      (gPressure) 
Group:Number:AVG            gPressure_Z5    "Preasure attic"            <pressure>      (gPressure) 

// Main target temperatures by zone (workaround) - Used by knobs
Group                       gMainSetpoints     "Main setpoints"                (Home)
Number:Temperature          MainSetpoint_Z1    "Setpoint Zone 1 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z2    "Setpoint Zone 2 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z3    "Setpoint Zone 3 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z4    "Setpoint Zone 4 [%.1f %unit%]"     <temperature>   (gMainSetpoints)

// Target temperature by zone - Recorded
Group                       gSetpoint         "Zone Setpoints"              (Home)
Group:Number:AVG            gSetpoint_Z1      "Setpoint Avg Zone 1"            <temperature>    (gSetpoint)    
Group:Number:AVG            gSetpoint_Z2      "Setpoint Avg Zone 2"            <temperature>    (gSetpoint)
Group:Number:AVG            gSetpoint_Z3      "Setpoint Avg Zone 3"            <temperature>    (gSetpoint)
Group:Number:AVG            gSetpoint_Z4      "Setpoint Avg Zone 4"            <temperature>    (gSetpoint)

// Heating running state by zone
Group:Switch:OR(ON, OFF)    gHeater_Z1        "Radiator Zone 1"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z2        "Radiator Zone 2"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z3        "Radiator Zone 3"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z4        "Radiator Zone 4"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z5        "Radiator Zone 4"                <heater>    (Home)

// Weather Station
Number:Temperature      OU_Temperature        "Temperature Outdoors [%.1f %unit%]"       <temperature>        (OU_Terrace)                           {channel="mqtt:topic:mosquitto:rflink:barigo"}

//**********************************************************************************
// Thermostats
//**********************************************************************************
// ZONE 1 (Z1): Bathrooms (warmest)
// ZONE 2 (Z2): Living rooms (middle)
// ZONE 3 (Z3): Bedrooms + Entry (cold)
// ZONE 4 (Z4): Basement (not heated)
// ZONE 5 (Z5): Attic

// For Smart Radiator Valves, use a label prefixed by 'srv_' (Smart Radiator Valve)
// For A non-connected valve, use a label prefixed by 'trv_  (Thermostatic Radiator Valve)

// Entry - Smart Radiator Valve (SRV)
Switch                  GF_Entryway_Heating     "srv_entry"                       <heating>              (GF_Entryway, gHeater, gHeater_Z3)                  
Switch                  GF_Entryway_Ignored     "Entryway"                          <error>              (GF_Entryway, gHeaterIgnored)                  
String                  GF_Entryway_Preset      "Mode"                            <heating>              (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:preset"} 
Switch                  GF_Entryway_BatteryLow  "Entryway"                          <battery>            (GF_Entryway, gBatteryLow)                  {channel="mqtt:topic:mosquitto:srv_entry:battery_low"} 
Contact                 GF_Entryway_WindowOpen  "Open window"                 <window>                   (GF_Entryway, gWindow)                      //{channel="mqtt:topic:mosquitto:srv_entry:window_open"} 
Dimmer                  GF_Entryway_Position    "Opening"                       <radiator>               (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:position" } 
Number:Temperature      GF_Entryway_Setpoint    "Setpoint [%.1f %unit%]"             <temperature>       (GF_Entryway, gSetpoint_Z3)                 {channel="mqtt:topic:mosquitto:srv_entry:setpoint", ga="thermostatTemperatureSetpoint"}
Number:Temperature      GF_Entryway_Offset      "Calibration [%.1f %unit%]"       <temperature>          (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:offset"}
Number:Temperature      GF_Entryway_LocalTemp   "Local [%.1f %unit%]"             <temperature>          (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:temperature"}
Number:Temperature      GF_Entryway_Temperature "Entryway [%.1f %unit%]"            <temperature>        (GF_Entryway, gTemp_Z3)                     {channel="mqtt:topic:mosquitto:thp_entry:temperature", ga="thermostatTemperatureAmbient"}
Number                  GF_Entryway_Humidity    "Humidity [%.1f %%]"              <humidity>             (GF_Entryway, gHumidity_Z3)                 {channel="mqtt:topic:mosquitto:thp_entry:humidity", ga="thermostatHumidityAmbient"}
Number:Pressure         GF_Entryway_Pressure    "Preasure [%.1f %unit%]"          <pressure>             (GF_Entryway, gPressure_Z3)                 {channel="mqtt:topic:mosquitto:thp_entry:pressure"}
Number                  GF_Entryway_THPSignal   "Entryway [%d]"                     <signal>             (GF_Entryway, gSignal)                      {channel="mqtt:topic:mosquitto:thp_entry:quality"}
Dimmer                  GF_Entryway_THPBattery  "Entryway [%d %%]"                  <battery>            (GF_Entryway, gBattery)                     {channel="mqtt:topic:mosquitto:thp_entry:battery"}

// Kitchen - Smart Radiator Valve (SRV)
Switch                  GF_Kitchen_Heating           "srv_kitchen"                <heating>              (GF_Kitchen, gHeater, gHeater_Z2)            
Switch                  GF_Kitchen_Ignored           "Kitchen"                    <error>                (GF_Kitchen, gHeaterIgnored)                  
String                  GF_Kitchen_Preset            "Mode"                       <heating>              (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:preset"}       
Switch                  GF_Kitchen_BatteryLow        "Kitchen"                    <battery>              (GF_Kitchen, gBatteryLow)                  {channel="mqtt:topic:mosquitto:srv_kitchen:battery_low"}
Contact                 GF_Kitchen_WindowOpen        "Open window"            <window>                   (GF_Kitchen, gWindow)                      //{channel="mqtt:topic:mosquitto:srv_kitchen:window_open"} 
Dimmer                  GF_Kitchen_Position          "Opening"                  <radiator>               (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:position" }  
Number:Temperature      GF_Kitchen_Setpoint          "Setpoint [%.1f %unit%]"        <temperature>       (GF_Kitchen, gSetpoint_Z2)                 {channel="mqtt:topic:mosquitto:srv_kitchen:setpoint", ga="thermostatTemperatureSetpoint"}
Number:Temperature      GF_Kitchen_Offset            "Calibration [%.1f %unit%]"  <temperature>          (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:offset"}
Number:Temperature      GF_Kitchen_LocalTemp         "Local [%.1f %unit%]"        <temperature>          (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:temperature"}
Number:Temperature      GF_Kitchen_Temperature       "Kitchen [%.1f %unit%]"      <temperature>          (GF_Kitchen, gTemp_Z2)                     {channel="mqtt:topic:mosquitto:thp_kitchen:temperature", ga="thermostatTemperatureAmbient"}
Number                  GF_Kitchen_Humidity          "Humidity [%.1f %%]"         <humidity>             (GF_Kitchen, gHumidity_Z2)                 {channel="mqtt:topic:mosquitto:thp_kitchen:humidity", ga="thermostatHumidityAmbient"}
Number:Pressure         GF_Kitchen_Pressure          "Preasure [%.1f %unit%]"     <pressure>             (GF_Kitchen, gPressure_Z2)                 {channel="mqtt:topic:mosquitto:thp_kitchen:pressure"}
Number                  GF_Kitchen_THPSignal         "Kitchen [%d]"               <signal>               (GF_Kitchen, gSignal)                      {channel="mqtt:topic:mosquitto:thp_kitchen:quality"}
Dimmer                  GF_Kitchen_THPBattery        "Kitchen [%d %%]"            <battery>              (GF_Kitchen, gBattery)                     {channel="mqtt:topic:mosquitto:thp_kitchen:battery"}

// Lounge - Smart Radiator Valve (SRV)
Switch                  GF_Lounge_Heating       "srv_lounge"                      <heating>              (GF_Lounge, gHeater, gHeater_Z2)                    
Switch                  GF_Lounge_Ignored       "Lounge"                          <error>                (GF_Lounge, gHeaterIgnored)                  
