/****************************************************************************************
System:     OpenHAB version 2.5
File:       heating.items
Purpose:    To define items used by the Heating System
Author :    Jaime Rubio 2023 (c)
Notes:      I put the labels in French because they are often used by the UI HabPanel
*****************************************************************************************/

//**********************************************************************************
// Groups
//**********************************************************************************

// Heating control
Switch          Heating_Switch              "Commande de chauffage"            <switch>       (Home)       
Switch          Heating_Timer               "Plage horaire chauffage allumé"   <timer>        (Home)    //ON=Heating period;OFF=Idle period
Number          Heating_LastChange          "Dernier changement d'état"        <timer>        (Home)    //Last time the boiler changed
Switch          Heating_Init                "Initialize les radiateurs"        <switch>       (Home)    //Flag to initialize the radiators
Switch          Heating_Calibrate           "Calibration des radiateurs"       <switch>       (Home)    //Flag to calibrate the radiators
Switch          Heating_ChildLock           "Sécurité enfants"                 <switch>       (Home)    //Flag to set the child lock
Switch          Heating_AutoLock            "Blocage des radiateurs"           <switch>       (Home)    //Flag to set the auto lock
Switch          Heating_Toogle              "Toogle a change of settings"      <switch>       (Home)    //Flag to trigger an update after new settings

// Heater settings
Number          Heating_BoostTime           "Temps de Boost [%d]"              <timer>        (Home)
Number          Heating_DaysAway            "Durée des vacances [%d]"          <timer>        (Home)
DateTime        Heating_FirstDayAway        "Premier jour de vacances"         <timer>        (Home)
Switch          ValveDetection              "Détection des vannes"             <heating>      (Home)

// Regulation modes
Group:Switch:OR(ON, OFF)           gRegModes                    (Home)
Switch          Heating_Schedule            "Mode Horodateur"  <heating>            (gRegModes)    
Switch          Heating_Comfort             "Mode Confort"     <heating>            (gRegModes)    
Switch          Heating_Eco                 "Mode Eco"         <heating>            (gRegModes)    
Switch          Heating_Boost               "Mode Boost"       <heating>            (gRegModes)    
Switch          Heating_Manual              "Mode Manuel"      <heating>            (gRegModes)    
Switch          Heating_Away                "Mode Vacances"    <heating>            (gRegModes)    
Switch          Heating_Off                 "Mode Eteint"      <heating>            (gRegModes)    
String          Heating_Mode                "Mode Actuel"      <heating>            


// Temperature setpoint by mode
Group:Number:AVG            gSetpointModes
Number:Temperature          Setpoint_Comfort    "Cible Confort [%.1f %unit%]"       <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Eco        "Cible Eco [%.1f %unit%]"           <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Away       "Cible Vacances [%.1f %unit%]"      <temperature>         (gSetpointModes)
Number:Temperature          Setpoint_Loss       "Perte Maximale [%.1f %unit%]"      <temperature>         (Home) 

// Heaters/Radiators/TRV
Group:Switch:OR(ON, OFF)    gHeater         "Radiateur"                       <heating>      (Home)
Group:Switch:OR(ON, OFF)    gHeaterIgnored  "Radiateur ignoré"                <heating>      (Home)

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gTemperature    "Température"               <temperature>   (Home)
Group:Number:AVG            gTemp_Z1        "Température Salles d'eau"  <temperature>   (gTemperature)       
Group:Number:AVG            gTemp_Z2        "Température RdC"           <temperature>   (gTemperature)   
Group:Number:AVG            gTemp_Z3        "Température EtageZone"     <temperature>   (gTemperature)       
Group:Number:AVG            gTemp_Z4        "Température Sous-sol"      <temperature>   (gTemperature)  
Group:Number:AVG            gTemp_Z5        "Température Grenier"       <temperature>   (gTemperature)  

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gHumidity       "Humidité"                <humidity>      (Home)
Group:Number:AVG            gHumidity_Z1    "Humidité Salles d'eau"   <humidity>      (gHumidity)       
Group:Number:AVG            gHumidity_Z2    "Humidité RdC"            <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z3    "Humidité Etage"          <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z4    "Humidité Sous-sol"       <humidity>      (gHumidity)    
Group:Number:AVG            gHumidity_Z5    "Humidité Grenier"        <humidity>      (gHumidity)    

// Current average temperatures by zone. Thermostats are grouped by zone
Group:Number:AVG            gPressure       "Pression"                <pressure>      (Home)
Group:Number:AVG            gPressure_Z1    "Pression Salles d'eau"   <pressure>      (gPressure)       
Group:Number:AVG            gPressure_Z2    "Pression RdC"            <pressure>      (gPressure)   
Group:Number:AVG            gPressure_Z3    "Pression Etage"          <pressure>      (gPressure) 
Group:Number:AVG            gPressure_Z4    "Pression Sous-sol"       <pressure>      (gPressure) 
Group:Number:AVG            gPressure_Z5    "Pression Grenier"        <pressure>      (gPressure) 

// Main target temperatures by zone (workaround) - Used by knobs
Group                       gMainSetpoints     "Main set points"                (Home)
Number:Temperature          MainSetpoint_Z1    "Cible Zone 1 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z2    "Cible Zone 2 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z3    "Cible Zone 3 [%.1f %unit%]"     <temperature>   (gMainSetpoints)
Number:Temperature          MainSetpoint_Z4    "Cible Zone 4 [%.1f %unit%]"     <temperature>   (gMainSetpoints)

// Target temperature by zone - Recorded
Group                       gSetpoint         "Températures cible"              (Home)
Group:Number:AVG            gSetpoint_Z1      "Cible Moyenne Zone 1"            <temperature>    (gSetpoint)    
Group:Number:AVG            gSetpoint_Z2      "Cible Moyenne Zone 2"            <temperature>    (gSetpoint)
Group:Number:AVG            gSetpoint_Z3      "Cible Moyenne Zone 3"            <temperature>    (gSetpoint)
Group:Number:AVG            gSetpoint_Z4      "Cible Moyenne Zone 4"            <temperature>    (gSetpoint)

// Heating running state by zone
Group:Switch:OR(ON, OFF)    gHeater_Z1        "Radiateur Zone 1"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z2        "Radiateur Zone 2"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z3        "Radiateur Zone 3"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z4        "Radiateur Zone 4"                <heater>    (Home)
Group:Switch:OR(ON, OFF)    gHeater_Z5        "Radiateur Zone 4"                <heater>    (Home)

// Weather Station
Number:Temperature      OU_Temperature        "Température Ext [%.1f %unit%]"       <temperature>        (OU_Terrace)                           {channel="mqtt:topic:mosquitto:rflink:barigo"}

//**********************************************************************************
// Thermostats
//**********************************************************************************
// ZONE 1 (Z1): Bathrooms (warmest)
// ZONE 2 (Z2): Living rooms (middle)
// ZONE 3 (Z3): Bedrooms + Entry (cold)
// ZONE 4 (Z4): Basement (not heated)
// ZONE 5 (Z5): Attic

// For Smart Radiator Valves, use a label prefixed by 'srv_' (Smart Radiator Valve)
// For A non-connected valve, use a label prefixed by 'trv_  (Thermostatic Radiator Valve)

// Entry - Smart Radiator Valve (SRV)
Switch                  GF_Entryway_Heating     "srv_entry"                       <heating>              (GF_Entryway, gHeater, gHeater_Z3)                  
Switch                  GF_Entryway_Ignored     "Entrée"                          <error>                (GF_Entryway, gHeaterIgnored)                  
String                  GF_Entryway_Preset      "Mode"                            <heating>              (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:preset"} 
Switch                  GF_Entryway_BatteryLow  "Entrée"                          <battery>              (GF_Entryway, gBatteryLow)                  {channel="mqtt:topic:mosquitto:srv_entry:battery_low"} 
Contact                 GF_Entryway_WindowOpen  "Fenêtre ouverte"                 <window>               (GF_Entryway, gWindow)                      //{channel="mqtt:topic:mosquitto:srv_entry:window_open"} 
Dimmer                  GF_Entryway_Position    "Ouverture"                       <radiator>             (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:position" } 
Number:Temperature      GF_Entryway_Setpoint    "Cible [%.1f %unit%]"             <temperature>          (GF_Entryway, gSetpoint_Z3)                 {channel="mqtt:topic:mosquitto:srv_entry:setpoint", ga="thermostatTemperatureSetpoint"}
Number:Temperature      GF_Entryway_Offset      "Calibration [%.1f %unit%]"       <temperature>          (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:offset"}
Number:Temperature      GF_Entryway_LocalTemp   "Local [%.1f %unit%]"             <temperature>          (GF_Entryway)                               {channel="mqtt:topic:mosquitto:srv_entry:temperature"}
Number:Temperature      GF_Entryway_Temperature "Entrée [%.1f %unit%]"            <temperature>          (GF_Entryway, gTemp_Z3)                     {channel="mqtt:topic:mosquitto:thp_entry:temperature", ga="thermostatTemperatureAmbient"}
Number                  GF_Entryway_Humidity    "Humidité [%.1f %%]"              <humidity>             (GF_Entryway, gHumidity_Z3)                 {channel="mqtt:topic:mosquitto:thp_entry:humidity", ga="thermostatHumidityAmbient"}
Number:Pressure         GF_Entryway_Pressure    "Pression [%.1f %unit%]"          <pressure>             (GF_Entryway, gPressure_Z3)                 {channel="mqtt:topic:mosquitto:thp_entry:pressure"}
Number                  GF_Entryway_THPSignal   "Entrée [%d]"                     <signal>               (GF_Entryway, gSignal)                      {channel="mqtt:topic:mosquitto:thp_entry:quality"}
Dimmer                  GF_Entryway_THPBattery  "Entrée [%d %%]"                  <battery>              (GF_Entryway, gBattery)                     {channel="mqtt:topic:mosquitto:thp_entry:battery"}

// Kitchen - Smart Radiator Valve (SRV)
Switch                  GF_Kitchen_Heating           "srv_kitchen"                <heating>              (GF_Kitchen, gHeater, gHeater_Z2)            
Switch                  GF_Kitchen_Ignored           "Cuisine"                    <error>                (GF_Kitchen, gHeaterIgnored)                  
String                  GF_Kitchen_Preset            "Mode"                       <heating>              (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:preset"}       
Switch                  GF_Kitchen_BatteryLow        "Cuisine"                    <battery>              (GF_Kitchen, gBatteryLow)                  {channel="mqtt:topic:mosquitto:srv_kitchen:battery_low"}
