Number:Temperature      GF_Kitchen_Offset            "Calibration [%.1f %unit%]"  <temperature>          (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:offset"}
Number:Temperature      GF_Kitchen_LocalTemp         "Local [%.1f %unit%]"        <temperature>          (GF_Kitchen)                               {channel="mqtt:topic:mosquitto:srv_kitchen:temperature"}
Number:Temperature      GF_Kitchen_Temperature       "Cuisine [%.1f %unit%]"      <temperature>          (GF_Kitchen, gTemp_Z2)                     {channel="mqtt:topic:mosquitto:thp_kitchen:temperature", ga="thermostatTemperatureAmbient"}
Number                  GF_Kitchen_Humidity          "Humidité [%.1f %%]"         <humidity>             (GF_Kitchen, gHumidity_Z2)                 {channel="mqtt:topic:mosquitto:thp_kitchen:humidity", ga="thermostatHumidityAmbient"}
Number:Pressure         GF_Kitchen_Pressure          "Pression [%.1f %unit%]"     <pressure>             (GF_Kitchen, gPressure_Z2)                 {channel="mqtt:topic:mosquitto:thp_kitchen:pressure"}
Number                  GF_Kitchen_THPSignal         "Cuisine [%d]"               <signal>               (GF_Kitchen, gSignal)                      {channel="mqtt:topic:mosquitto:thp_kitchen:quality"}
Dimmer                  GF_Kitchen_THPBattery        "Cuisine [%d %%]"            <battery>              (GF_Kitchen, gBattery)                     {channel="mqtt:topic:mosquitto:thp_kitchen:battery"}

